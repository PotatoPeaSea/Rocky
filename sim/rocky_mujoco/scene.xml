<mujoco model="rocky_scene">
  <include file="rocky.xml"/>
  <statistic center="0 0 0.1" extent="0.6" meansize="0.03"/>
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>
  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.05"/>
  </asset>
  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001"/>
  </worldbody>
  <sensor>
    <!-- foot/floor contact flags (used by the MJX env; handy for gait code too) -->
    <contact name="leg1_floor_found" geom1="leg1_foot" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="leg2_floor_found" geom1="leg2_foot" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="leg3_floor_found" geom1="leg3_foot" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="leg4_floor_found" geom1="leg4_foot" geom2="floor" reduce="mindist" num="1" data="found"/>
    <contact name="leg5_floor_found" geom1="leg5_foot" geom2="floor" reduce="mindist" num="1" data="found"/>
  </sensor>
</mujoco>
